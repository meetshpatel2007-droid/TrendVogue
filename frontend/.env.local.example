# Trend Vogue Frontend Environment Variables

# Database (shared from backend)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT Secrets (must match backend)
JWT_ACCESS_SECRET="change-me-to-a-strong-random-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-strong-random-secret-min-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
